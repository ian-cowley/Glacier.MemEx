<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Package Metadata -->
    <PackageId>Glacier.MemEx</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier Software</Company>
    <Product>Glacier .NET 10 Ecosystem</Product>
    <Description>Universal episodic memory engine uniting Chrono, DocTree, Vector, HippoRAG PPR, and Bundle with ACT-R power-law temporal decay for .NET 10.</Description>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.MemEx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.MemEx</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Glacier Software</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Quant/src/Glacier.Quant/Glacier.Quant.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Quant/src/Glacier.Quant/Glacier.Quant.csproj" />
    <ProjectReference Include="../../../Glacier.DocTree/src/Glacier.DocTree/Glacier.DocTree.csproj" />
    <ProjectReference Include="../../../Glacier.Chrono/src/Glacier.Chrono/Glacier.Chrono.csproj" />
    <ProjectReference Include="../../../Glacier.Bundle/src/Glacier.Bundle/Glacier.Bundle.csproj" />
    <ProjectReference Include="../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj" />
    <ProjectReference Include="../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Quant/src/Glacier.Quant/Glacier.Quant.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Quant" Version="1.0.0" />
    <PackageReference Include="Glacier.DocTree" Version="1.3.0" />
    <PackageReference Include="Glacier.Chrono" Version="1.2.0" />
    <PackageReference Include="Glacier.Bundle" Version="1.1.0" />
    <PackageReference Include="Glacier.Vector" Version="1.2.0" />
    <PackageReference Include="Glacier.Graph" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.MemEx.Tests" />
  </ItemGroup>

</Project>
