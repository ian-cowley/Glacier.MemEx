<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Package Metadata -->
    <PackageId>Glacier.MemEx</PackageId>
    <Version>1.2.3</Version>
    <PackageReleaseNotes>v1.2.3: Cached CSR HippoRAG PPR (seed-teleport dangling mass), FWHT 1-bit + bounded heap vector recall, full formatted token budgeting, and pruned unused dependencies.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier Software</Company>
    <Product>Glacier .NET 10 Ecosystem</Product>
    <Description>Universal episodic memory engine uniting Glacier.Vector (FWHT 1-bit + FP32), Glacier.Graph (HippoRAG CSR Personalized PageRank), Glacier.Bundle (TokenBudget), Glacier.Rag, and Glacier.Inference with ACT-R power-law temporal decay and 0/1 knapsack prompt packing for .NET 10.</Description>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.MemEx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.MemEx</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Glacier Software</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Bundle/src/Glacier.Bundle/Glacier.Bundle.csproj" Condition="Exists('../../../Glacier.Bundle/src/Glacier.Bundle/Glacier.Bundle.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Bundle" Condition="!Exists('../../../Glacier.Bundle/src/Glacier.Bundle/Glacier.Bundle.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj" Condition="Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Vector" Condition="!Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj" Condition="Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Graph" Condition="!Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Rag" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Inference" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.MemEx.Tests" />
  </ItemGroup>

</Project>
